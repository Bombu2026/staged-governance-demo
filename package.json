{
  "name": "governance-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-vault.mjs --check && next dev --turbopack",
    "build": "node scripts/build-vault.mjs && next build",
    "start": "next start",
    "vault": "node scripts/build-vault.mjs",
    "contracts": "node scripts/compile-contracts.mjs",
    "contracts:check": "node scripts/compile-contracts.mjs --check",
    "contracts:deploy": "bun scripts/deploy-contracts.ts",
    "contracts:verify": "bun scripts/verify-contracts.ts",
    "sepolia:check": "bun scripts/base-sepolia-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:sim": "node scripts/e2e/sim.cjs",
    "e2e:live": "node scripts/e2e/live.cjs",
    "devnet:check": "node scripts/devnet-check.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@sqds/multisig": "2.1.4",
    "buffer": "6.0.3",
    "marked": "^18.1.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "2.57.18"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "solc": "0.8.38",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
